<Window
    x:Class="NxtFlyout.Views.TaskbarWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:NxtFlyout.Localization"
    xmlns:views="clr-namespace:NxtFlyout.Views"
    Title="NxtFlyout"
    Height="40"
    MaxWidth="480"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="Width"
    SnapsToDevicePixels="True"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <!--
        Sits on top of the taskbar, so it has no background of its own. Its text colour is
        set from code to contrast with the taskbar, and the buttons inherit it.
    -->
    <!-- The almost-invisible fill makes the whole widget clickable, not just its text and picture. -->
    <Grid VerticalAlignment="Stretch" Background="#01FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Cover, title and artist: click to open the media flyout. -->
        <Button
            Grid.Column="0"
            Width="Auto"
            Height="Auto"
            HorizontalContentAlignment="Left"
            Command="{Binding OpenFlyoutCommand}"
            Style="{StaticResource TransportButtonStyle}"
            ToolTip="{loc:Loc Widget_Open}">
            <Grid Margin="6,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    Width="28"
                    Height="28">
                    <TextBlock
                        FontSize="14"
                        Opacity="0.7"
                        Style="{StaticResource GlyphStyle}"
                        Text="&#xE8D6;" />
                    <Border CornerRadius="4">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Artwork, Converter={StaticResource BytesToImageConverter}}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    MaxWidth="170"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.75"
                        Text="{Binding Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- Previous / play-pause / next. -->
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Command="{Binding PreviousCommand}"
                IsEnabled="{Binding CanGoPrevious}"
                Style="{StaticResource TransportButtonStyle}"
                ToolTip="{loc:Loc Media_Previous}">
                <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE892;" />
            </Button>
            <Button
                Command="{Binding PlayPauseCommand}"
                IsEnabled="{Binding CanTogglePlayPause}"
                Style="{StaticResource TransportButtonStyle}"
                ToolTip="{loc:Loc Media_PlayPause}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource GlyphStyle}" TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE768;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Text" Value="&#xE769;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <Button
                Command="{Binding NextCommand}"
                IsEnabled="{Binding CanGoNext}"
                Style="{StaticResource TransportButtonStyle}"
                ToolTip="{loc:Loc Media_Next}">
                <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE893;" />
            </Button>
        </StackPanel>

        <!-- Audio visualizer: draws nothing interactive, so clicks pass to the window background. -->
        <views:VisualizerBars
            Grid.Column="2"
            Margin="8,0,10,0"
            VerticalAlignment="Stretch"
            Alignment="{Binding VisualizerAlignment}"
            BarCount="{Binding VisualizerBarCount}"
            ColorMode="{Binding VisualizerColorMode}"
            CustomColor="{Binding VisualizerCustomColor}"
            IsHitTestVisible="False"
            Levels="{Binding VisualizerLevels}"
            Visibility="{Binding ShowVisualizer, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Window>
