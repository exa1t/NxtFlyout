<Page
    x:Class="NxtFlyout.Views.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:NxtFlyout.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="0,24,0,24">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{loc:Loc Nav_Appearance}" />

        <TextBlock
            Margin="0,0,0,8"
            Style="{StaticResource SectionHeaderStyle}"
            Text="{loc:Loc Appearance_Section_Look}" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE708;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Appearance_Theme_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Appearance_Theme_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemTemplate="{StaticResource OptionItemTemplate}"
                ItemsSource="{Binding Themes, Mode=OneTime}"
                SelectedItem="{Binding Theme, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Appearance_Backdrop_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Appearance_Backdrop_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemTemplate="{StaticResource OptionItemTemplate}"
                ItemsSource="{Binding Backdrops, Mode=OneTime}"
                SelectedItem="{Binding Backdrop, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding IsTranslucentBackdrop, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE706;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Appearance_TranslucentOpacity_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Appearance_TranslucentOpacity_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="40"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="{Binding TranslucentOpacity, Mode=OneWay, StringFormat='{}{0:0} %'}"
                    TextAlignment="Right" />
                <Slider
                    Width="220"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding MaxTranslucentOpacity, Mode=OneTime}"
                    Minimum="{Binding MinTranslucentOpacity, Mode=OneTime}"
                    TickFrequency="5"
                    Value="{Binding TranslucentOpacity, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Appearance_Section_Layout}" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE7C2;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Appearance_Position_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Appearance_Position_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="120"
                    Margin="0,0,8,0"
                    ItemTemplate="{StaticResource OptionItemTemplate}"
                    ItemsSource="{Binding VerticalPositions, Mode=OneTime}"
                    SelectedItem="{Binding VerticalPosition, Mode=TwoWay}" />
                <ComboBox
                    MinWidth="120"
                    ItemTemplate="{StaticResource OptionItemTemplate}"
                    ItemsSource="{Binding HorizontalPositions, Mode=OneTime}"
                    SelectedItem="{Binding HorizontalPosition, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE7F4;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Appearance_Display_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Appearance_Display_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemTemplate="{StaticResource OptionItemTemplate}"
                ItemsSource="{Binding Displays, Mode=OneTime}"
                SelectedItem="{Binding Display, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE73F;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Appearance_Compact_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Appearance_Compact_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding CompactLayout, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xEC4A;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Appearance_AnimationSpeed_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Appearance_AnimationSpeed_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemTemplate="{StaticResource OptionItemTemplate}"
                ItemsSource="{Binding AnimationSpeeds, Mode=OneTime}"
                SelectedItem="{Binding AnimationSpeed, Mode=TwoWay}" />
        </ui:CardControl>
    </StackPanel>
</Page>
