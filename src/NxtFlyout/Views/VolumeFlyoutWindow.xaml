<views:FlyoutWindowBase
    x:Class="NxtFlyout.Views.VolumeFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:NxtFlyout.Views">
    <!-- Speaker icon, level bar, percentage. -->
    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            Width="22"
            FontSize="18"
            Style="{StaticResource GlyphStyle}"
            Text="{Binding Glyph}" />

        <ProgressBar
            Grid.Column="1"
            Margin="12,0,12,0"
            VerticalAlignment="Center"
            Maximum="100"
            Minimum="0"
            Value="{Binding Percent, Mode=OneWay}">
            <ProgressBar.Style>
                <Style BasedOn="{StaticResource TimelineStyle}" TargetType="ProgressBar">
                    <Style.Triggers>
                        <!-- A muted level is shown dimmed rather than emptied, so the level stays readable. -->
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <TextBlock
            Grid.Column="2"
            MinWidth="26"
            VerticalAlignment="Center"
            FontSize="13"
            FontWeight="SemiBold"
            Text="{Binding Percent}"
            TextAlignment="Right" />
    </Grid>
</views:FlyoutWindowBase>
