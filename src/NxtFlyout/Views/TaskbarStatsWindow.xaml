<Window
    x:Class="NxtFlyout.Views.TaskbarStatsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:NxtFlyout.Localization"
    Title="NxtFlyout stats"
    Height="40"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="Width"
    SnapsToDevicePixels="True"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <!--
        Two lines of text over the taskbar, right-aligned so they sit against the tray. Like the
        widget it has no background of its own; the text colour is set from code to contrast with
        the taskbar. Digits are tabular so the text does not jitter as the figures change.
        The almost-invisible fill makes the whole panel clickable: a click opens Task Manager.
    -->
    <Grid
        x:Name="LayoutRoot"
        Background="#01FFFFFF"
        Cursor="Hand"
        MouseLeftButtonUp="OnClicked"
        ToolTip="{loc:Loc Stats_Open_Tooltip}">
        <StackPanel
            Margin="6,0,6,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="TextAlignment" Value="Right" />
                    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                </Style>
            </StackPanel.Resources>
            <TextBlock x:Name="FirstLine" />
            <TextBlock x:Name="SecondLine" Opacity="0.85" />
        </StackPanel>
    </Grid>
</Window>
