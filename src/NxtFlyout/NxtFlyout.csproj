<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 2004 SDK projection is what exposes Windows.Media.Control (SMTC). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is referenced only for NotifyIcon (the tray icon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NxtFlyout</RootNamespace>
    <AssemblyName>NxtFlyout</AssemblyName>
    <ApplicationIcon>Assets\NxtFlyout.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is declared in app.manifest on purpose; silence the WinForms hint about it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the WinForms/GDI namespaces out of the global usings: they clash with WPF type names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
    <!-- WASAPI loopback capture for the taskbar visualizer. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NxtFlyout.Core\NxtFlyout.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\NxtFlyout.ico" />
    <Resource Include="Assets\Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship our licence and the third-party notices next to NxtFlyout.exe, so the installer and
         the portable zip (both made from the publish folder) carry them. MIT requires the notices. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
