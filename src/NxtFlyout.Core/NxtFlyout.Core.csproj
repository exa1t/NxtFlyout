<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral logic: settings, localization and view models.
    Nothing in here references WPF or Windows APIs, so it can be unit tested anywhere.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NxtFlyout.Core</RootNamespace>
    <AssemblyName>NxtFlyout.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NxtFlyout.Tests" />
  </ItemGroup>

</Project>
