<Page
    x:Class="NxtHUD.Views.Pages.FlyoutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:NxtHUD.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="0,24,0,24">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{loc:Loc Nav_Flyouts}" />

        <TextBlock
            Margin="0,0,0,8"
            Style="{StaticResource SectionHeaderStyle}"
            Text="{loc:Loc Flyouts_Section_Flyouts}" />

        <!-- Media flyout (its position is on the Appearance page) -->
        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE768;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_Media_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_Media_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding MediaFlyoutEnabled, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Volume flyout -->
        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE767;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_Volume_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_Volume_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="150"
                    Margin="0,0,12,0"
                    ItemTemplate="{StaticResource OptionItemTemplate}"
                    ItemsSource="{Binding FlyoutPositions, Mode=OneTime}"
                    SelectedItem="{Binding VolumePosition, Mode=TwoWay}"
                    ToolTip="{loc:Loc Flyouts_Position_Tooltip}" />
                <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding VolumeFlyoutEnabled, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding VolumeFlyoutEnabled, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE74F;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_ReplaceNative_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_ReplaceNative_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ReplaceNativeVolumeOverlay, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Lock keys flyout -->
        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE765;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_LockKeys_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_LockKeys_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="150"
                    Margin="0,0,12,0"
                    ItemTemplate="{StaticResource OptionItemTemplate}"
                    ItemsSource="{Binding FlyoutPositions, Mode=OneTime}"
                    SelectedItem="{Binding LockKeysPosition, Mode=TwoWay}"
                    ToolTip="{loc:Loc Flyouts_Position_Tooltip}" />
                <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding LockKeysFlyoutEnabled, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Up Next flyout -->
        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE893;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_UpNext_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_UpNext_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="150"
                    Margin="0,0,12,0"
                    ItemTemplate="{StaticResource OptionItemTemplate}"
                    ItemsSource="{Binding FlyoutPositions, Mode=OneTime}"
                    SelectedItem="{Binding UpNextPosition, Mode=TwoWay}"
                    ToolTip="{loc:Loc Flyouts_Position_Tooltip}" />
                <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding UpNextFlyoutEnabled, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Taskbar widget -->
        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE90E;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_TaskbarWidget_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_TaskbarWidget_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding TaskbarWidgetEnabled, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding TaskbarWidgetEnabled, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE7C2;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_WidgetOffset_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_WidgetOffset_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="48"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="{Binding TaskbarWidgetOffset, Mode=OneWay, StringFormat='{}{0:0} px'}"
                    TextAlignment="Right" />
                <Slider
                    Width="220"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding MaxTaskbarWidgetOffset, Mode=OneTime}"
                    Minimum="0"
                    TickFrequency="10"
                    Value="{Binding TaskbarWidgetOffset, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Taskbar visualizer -->
        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding TaskbarWidgetEnabled, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE9D9;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_Visualizer_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_Visualizer_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding TaskbarVisualizerEnabled, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding TaskbarVisualizerEnabled, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE8FD;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_VisualizerBars_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_VisualizerBars_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="32"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="{Binding VisualizerBarCount, Mode=OneWay, StringFormat='{}{0:0}'}"
                    TextAlignment="Right" />
                <Slider
                    Width="220"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding MaxVisualizerBars, Mode=OneTime}"
                    Minimum="{Binding MinVisualizerBars, Mode=OneTime}"
                    TickFrequency="1"
                    Value="{Binding VisualizerBarCount, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding TaskbarVisualizerEnabled, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE8CB;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_VisualizerDirection_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_VisualizerDirection_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="150"
                ItemTemplate="{StaticResource OptionItemTemplate}"
                ItemsSource="{Binding VisualizerAlignments, Mode=OneTime}"
                SelectedItem="{Binding VisualizerAlignment, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding TaskbarVisualizerEnabled, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_VisualizerColor_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_VisualizerColor_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="150"
                    Margin="0,0,12,0"
                    ItemTemplate="{StaticResource OptionItemTemplate}"
                    ItemsSource="{Binding VisualizerColorModes, Mode=OneTime}"
                    SelectedItem="{Binding VisualizerColorMode, Mode=TwoWay}" />
                <TextBox
                    Width="110"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding IsCustomVisualizerColor, Mode=OneWay}"
                    MaxLength="9"
                    Text="{Binding VisualizerCustomColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Taskbar stats -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Flyouts_Section_TaskbarStats}" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE9D2;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_TaskbarStats_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_TaskbarStats_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding TaskbarStatsEnabled, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding TaskbarStatsEnabled, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE762;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_StatsItems_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_StatsItems_Description}" />
                    <WrapPanel Margin="0,10,0,0">
                        <WrapPanel.Resources>
                            <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
                                <Setter Property="Margin" Value="0,0,16,4" />
                                <Setter Property="MinWidth" Value="0" />
                            </Style>
                        </WrapPanel.Resources>
                        <CheckBox Content="{loc:Loc Stats_Cpu}" IsChecked="{Binding StatsShowCpu, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Stats_Ram}" IsChecked="{Binding StatsShowRam, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Stats_Gpu}" IsChecked="{Binding StatsShowGpu, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Stats_Vram}" IsChecked="{Binding StatsShowVram, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Stats_GpuTemperature}" IsChecked="{Binding StatsShowGpuTemperature, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Stats_Network}" IsChecked="{Binding StatsShowNetwork, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Stats_Disk}" IsChecked="{Binding StatsShowDisk, Mode=TwoWay}" />
                    </WrapPanel>
                </StackPanel>
            </ui:CardControl.Header>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8" IsEnabled="{Binding TaskbarStatsEnabled, Mode=OneWay}">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE916;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_StatsInterval_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_StatsInterval_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="40"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="{Binding StatsIntervalSeconds, Mode=OneWay, StringFormat='{}{0:0.0} s'}"
                    TextAlignment="Right" />
                <Slider
                    Width="220"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding MaxStatsIntervalSeconds, Mode=OneTime}"
                    Minimum="{Binding MinStatsIntervalSeconds, Mode=OneTime}"
                    TickFrequency="0.5"
                    Value="{Binding StatsIntervalSeconds, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Flyouts_Section_Behavior}" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE916;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc Flyouts_Timeout_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc Flyouts_Timeout_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="48"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="{Binding TimeoutSeconds, Mode=OneWay, StringFormat='{}{0:0.0} s'}"
                    TextAlignment="Right" />
                <Slider
                    Width="220"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding MaxTimeoutSeconds, Mode=OneTime}"
                    Minimum="{Binding MinTimeoutSeconds, Mode=OneTime}"
                    TickFrequency="0.5"
                    Value="{Binding TimeoutSeconds, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</Page>
