<views:FlyoutWindowBase
    x:Class="NxtHUD.Views.LockKeysFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:NxtHUD.Views">
    <!-- Padlock icon and "Caps Lock is on". -->
    <StackPanel
        Margin="16,13,16,13"
        HorizontalAlignment="Center"
        Orientation="Horizontal">
        <TextBlock
            FontSize="16"
            Style="{StaticResource GlyphStyle}"
            Text="{Binding Glyph}" />
        <TextBlock
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Text="{Binding Text}" />
    </StackPanel>
</views:FlyoutWindowBase>
