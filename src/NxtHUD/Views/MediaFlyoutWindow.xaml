<views:FlyoutWindowBase
    x:Class="NxtHUD.Views.MediaFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:NxtHUD.Localization"
    xmlns:views="clr-namespace:NxtHUD.Views">
    <!-- Only the card's content is declared here; FlyoutWindowBase supplies the window and its chrome. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Album art, with a placeholder underneath for players that publish none. -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="76" />
                        <Setter Property="Height" Value="76" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Width" Value="60" />
                                <Setter Property="Height" Value="60" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border
                    Background="{DynamicResource TextFillColorPrimaryBrush}"
                    CornerRadius="8"
                    Opacity="0.08" />
                <TextBlock
                    FontSize="22"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource GlyphStyle}"
                    Text="&#xE8D6;" />
                <Border CornerRadius="8">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork, Converter={StaticResource BytesToImageConverter}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border
                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Opacity="0.10" />
            </Grid>

            <Grid
                Grid.Column="1"
                Margin="14,0,0,0"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,1,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Artist}"
                    TextTrimming="CharacterEllipsis" />

                <!-- Transport controls on the left, the player's name on the right. -->
                <Grid Grid.Row="2" Margin="-6,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button
                            Command="{Binding PreviousCommand}"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            IsEnabled="{Binding CanGoPrevious}"
                            Style="{StaticResource TransportButtonStyle}"
                            ToolTip="{loc:Loc Media_Previous}">
                            <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE892;" />
                        </Button>
                        <Button
                            Margin="6,0,6,0"
                            Command="{Binding PlayPauseCommand}"
                            IsEnabled="{Binding CanTogglePlayPause}"
                            Style="{StaticResource PlayPauseButtonStyle}"
                            ToolTip="{loc:Loc Media_PlayPause}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource GlyphStyle}" TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="&#xE769;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button
                            Command="{Binding NextCommand}"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            IsEnabled="{Binding CanGoNext}"
                            Style="{StaticResource TransportButtonStyle}"
                            ToolTip="{loc:Loc Media_Next}">
                            <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE893;" />
                        </Button>
                    </StackPanel>

                    <!-- The player's icon and name, like "[icon] Spotify". -->
                    <DockPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowSourceApp, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image
                            Width="16"
                            Height="16"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding SourceAppId, Converter={StaticResource AppIdToIconConverter}}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <Trigger Property="Source" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionStyle}"
                            Text="{Binding SourceAppName}"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Timeline across the full width: position, progress, duration. -->
        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            Visibility="{Binding ShowTimeline, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                MinWidth="28"
                Style="{StaticResource CaptionStyle}"
                Text="{Binding PositionText}" />
            <ProgressBar
                Grid.Column="1"
                Margin="8,0,8,0"
                VerticalAlignment="Center"
                Maximum="{Binding DurationSeconds, Mode=OneWay}"
                Minimum="0"
                Style="{StaticResource TimelineStyle}"
                Value="{Binding PositionSeconds, Mode=OneWay}" />
            <TextBlock
                Grid.Column="2"
                MinWidth="28"
                Style="{StaticResource CaptionStyle}"
                Text="{Binding DurationText}"
                TextAlignment="Right" />
        </Grid>
    </Grid>
</views:FlyoutWindowBase>
