<views:FlyoutWindowBase
    x:Class="NxtHUD.Views.UpNextFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:NxtHUD.Localization"
    xmlns:views="clr-namespace:NxtHUD.Views">
    <!-- Small album art, an "Up next" caption, then the track. -->
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Width="48"
            Height="48">
            <Border
                Background="{DynamicResource TextFillColorPrimaryBrush}"
                CornerRadius="6"
                Opacity="0.08" />
            <TextBlock
                FontSize="18"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource GlyphStyle}"
                Text="&#xE8D6;" />
            <Border CornerRadius="6">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Artwork, Converter={StaticResource BytesToImageConverter}}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>

        <StackPanel
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Center">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Style="{StaticResource CaptionStyle}"
                Text="{loc:Loc UpNext_Caption}" />
            <TextBlock
                Margin="0,1,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Artist}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</views:FlyoutWindowBase>
